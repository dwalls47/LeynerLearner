<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- A lamed; made by Tools\AppIcon\make-icon.ps1 -->
    <ApplicationIcon>LeynerLearner.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same icon for the windows' title bars (AppIcon.cs) -->
    <EmbeddedResource Include="LeynerLearner.ico" LogicalName="LeynerLearner.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hebrew text (MAM), English (World Messianic Bible), reading schedules (Hebcal) and the bundled font; see each folder's README.md -->
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>