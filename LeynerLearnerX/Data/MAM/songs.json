          "align": "right",
          "width": 0,
          "text": "יִפְרֹ֤שׂ כְּנָפָיו֙ יִקָּחֵ֔הוּ"
        },
        {
          "align": "left",
          "width": 0,
          "text": "יִשָּׂאֵ֖הוּ עַל־אֶבְרָתֽוֹ׃"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "יְהֹוָ֖ה בָּדָ֣ד יַנְחֶ֑נּוּ"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וְאֵ֥ין עִמּ֖וֹ אֵ֥ל נֵכָֽר׃"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "יַרְכִּבֵ֙הוּ֙ עַל־בָּ֣מֳתֵי אָ֔רֶץ"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וַיֹּאכַ֖ל תְּנוּבֹ֣ת שָׂדָ֑י"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וַיֵּנִקֵ֤הֽוּ דְבַשׁ֙ מִסֶּ֔לַע"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וְשֶׁ֖מֶן מֵחַלְמִ֥ישׁ צֽוּר׃"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "חֶמְאַ֨ת בָּקָ֜ר וַחֲלֵ֣ב צֹ֗אן"
        },
        {
          "align": "left",
          "width": 0,
          "text": "עִם־חֵ֨לֶב כָּרִ֜ים"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וְאֵילִ֤ים בְּנֵֽי־בָשָׁן֙ וְעַתּוּדִ֔ים"
        },
        {
          "align": "left",
          "width": 0,
          "text": "עִם־חֵ֖לֶב כִּלְי֣וֹת חִטָּ֑ה"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וְדַם־עֵנָ֖ב תִּשְׁתֶּה־חָֽמֶר׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וַיִּשְׁמַ֤ן יְשֻׁרוּן֙ וַיִּבְעָ֔ט"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "שָׁמַ֖נְתָּ עָבִ֣יתָ כָּשִׂ֑יתָ"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וַיִּטֹּשׁ֙ אֱל֣וֹהַּ עָשָׂ֔הוּ"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וַיְנַבֵּ֖ל צ֥וּר יְשֻׁעָתֽוֹ׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "יַקְנִאֻ֖הוּ בְּזָרִ֑ים"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "בְּתוֹעֵבֹ֖ת יַכְעִיסֻֽהוּ׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "יִזְבְּח֗וּ לַשֵּׁדִים֙ לֹ֣א אֱלֹ֔הַּ"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "אֱלֹהִ֖ים לֹ֣א יְדָע֑וּם"
        },
        {
          "align": "left",
          "width": 0,
          "text": "חֲדָשִׁים֙ מִקָּרֹ֣ב בָּ֔אוּ"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "לֹ֥א שְׂעָר֖וּם אֲבֹתֵיכֶֽם׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "צ֥וּר יְלָדְךָ֖ תֶּ֑שִׁי"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וַתִּשְׁכַּ֖ח אֵ֥ל מְחֹלְﬞלֶֽךָ׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וַיַּ֥רְא יְהֹוָ֖ה וַיִּנְאָ֑ץ"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "מִכַּ֥עַס בָּנָ֖יו וּבְנֹתָֽיו׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וַיֹּ֗אמֶר אַסְתִּ֤ירָה פָנַי֙ מֵהֶ֔ם"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "אֶרְאֶ֖ה מָ֣ה אַחֲרִיתָ֑ם"
        },
        {
          "align": "left",
          "width": 0,
          "text": "כִּ֣י ד֤וֹר תַּהְפֻּכֹת֙ הֵ֔מָּה"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "בָּנִ֖ים לֹא־אֵמֻ֥ן בָּֽם׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "הֵ֚ם קִנְא֣וּנִי בְלֹא־אֵ֔ל"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "כִּעֲס֖וּנִי בְּהַבְלֵיהֶ֑ם"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וַאֲנִי֙ אַקְנִיאֵ֣ם בְּלֹא־עָ֔ם"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "בְּג֥וֹי נָבָ֖ל אַכְעִיסֵֽם׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "כִּי־אֵשׁ֙ קָדְחָ֣ה בְאַפִּ֔י"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וַתִּיקַ֖ד עַד־שְׁא֣וֹל תַּחְתִּ֑ית"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וַתֹּ֤אכַל אֶ֙רֶץ֙ וִֽיבֻלָ֔הּ"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וַתְּלַהֵ֖ט מוֹסְדֵ֥י הָרִֽים׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "אַסְפֶּ֥ה עָלֵ֖ימוֹ רָע֑וֹת"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "חִצַּ֖י אֲכַלֶּה־בָּֽם׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "מְזֵ֥י רָעָ֛ב וּלְחֻ֥מֵי רֶ֖שֶׁף"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וְקֶ֣טֶב מְרִירִ֑י"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וְשֶׁן־בְּהֵמֹת֙ אֲשַׁלַּח־בָּ֔ם"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "עִם־חֲמַ֖ת זֹחֲלֵ֥י עָפָֽר׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "מִחוּץ֙ תְּשַׁכֶּל־חֶ֔רֶב"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וּמֵחֲדָרִ֖ים אֵימָ֑ה"
        },
        {
          "align": "left",
          "width": 0,
          "text": "גַּם־בָּחוּר֙ גַּם־בְּתוּלָ֔ה"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "יוֹנֵ֖ק עִם־אִ֥ישׁ שֵׂיבָֽה׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "אָמַ֖רְתִּי אַפְאֵיהֶ֑ם"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "אַשְׁבִּ֥יתָה מֵאֱנ֖וֹשׁ זִכְרָֽם׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "לוּלֵ֗י כַּ֤עַס אוֹיֵב֙ אָג֔וּר"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "פֶּֽן־יְנַכְּר֖וּ צָרֵ֑ימוֹ"
        },
        {
          "align": "left",
          "width": 0,
          "text": "פֶּן־יֹֽאמְרוּ֙ יָדֵ֣נוּ רָ֔מָה"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וְלֹ֥א יְהֹוָ֖ה פָּעַ֥ל כׇּל־זֹֽאת׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "כִּי־ג֛וֹי אֹבַ֥ד עֵצ֖וֹת הֵ֑מָּה"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וְאֵ֥ין בָּהֶ֖ם תְּבוּנָֽה׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "ל֥וּ חָכְמ֖וּ יַשְׂכִּ֣ילוּ זֹ֑את"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "יָבִ֖ינוּ לְאַחֲרִיתָֽם׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "אֵיכָ֞ה יִרְדֹּ֤ף אֶחָד֙ אֶ֔לֶף"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וּשְׁנַ֖יִם יָנִ֣יסוּ רְבָבָ֑ה"
        },
        {
          "align": "left",
          "width": 0,
          "text": "אִם־לֹא֙ כִּי־צוּרָ֣ם מְכָרָ֔ם"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וַֽיְהֹוָ֖ה הִסְגִּירָֽם׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "כִּ֛י לֹ֥א כְצוּרֵ֖נוּ צוּרָ֑ם"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וְאֹיְבֵ֖ינוּ פְּלִילִֽים׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "כִּֽי־מִגֶּ֤פֶן סְדֹם֙ גַּפְנָ֔ם"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וּמִשַּׁדְמֹ֖ת עֲמֹרָ֑ה"
        },
        {
          "align": "left",
          "width": 0,
          "text": "עֲנָבֵ֙מוֹ֙ עִנְּבֵי־ר֔וֹשׁ"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "אַשְׁכְּלֹ֥ת מְרֹרֹ֖ת לָֽמוֹ׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "חֲמַ֥ת תַּנִּינִ֖ם יֵינָ֑ם"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וְרֹ֥אשׁ פְּתָנִ֖ים אַכְזָֽר׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "הֲלֹא־ה֖וּא כָּמֻ֣ס עִמָּדִ֑י"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "חָת֖וּם בְּאוֹצְרֹתָֽי׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "לִ֤י נָקָם֙ וְשִׁלֵּ֔ם"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "לְעֵ֖ת תָּמ֣וּט רַגְלָ֑ם"
        },
        {
          "align": "left",
          "width": 0,
          "text": "כִּ֤י קָרוֹב֙ י֣וֹם אֵידָ֔ם"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וְחָ֖שׁ עֲתִדֹ֥ת לָֽמוֹ׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "כִּֽי־יָדִ֤ין יְהֹוָה֙ עַמּ֔וֹ"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וְעַל־עֲבָדָ֖יו יִתְנֶחָ֑ם"
        },
        {
          "align": "left",
          "width": 0,
          "text": "כִּ֤י יִרְאֶה֙ כִּֽי־אָ֣זְﬞלַת יָ֔ד"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וְאֶ֖פֶס עָצ֥וּר וְעָזֽוּב׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וְאָמַ֖ר אֵ֣י אֱלֹהֵ֑ימוֹ"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "צ֖וּר חָסָ֥יוּ בֽוֹ׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "אֲשֶׁ֨ר חֵ֤לֶב זְבָחֵ֙ימוֹ֙ יֹאכֵ֔לוּ"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "יִשְׁתּ֖וּ יֵ֣ין נְסִיכָ֑ם"
        },
        {
          "align": "left",
          "width": 0,
          "text": "יָק֙וּמוּ֙ וְיַעְזְרֻכֶ֔ם"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "יְהִ֥י עֲלֵיכֶ֖ם סִתְרָֽה׃"
        },
        {
          "align": "left",
          "width": 0,
          "text": "רְא֣וּעַתָּ֗ה כִּ֣י אֲנִ֤י אֲנִי֙ ה֔וּא"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "וְאֵ֥ין אֱלֹהִ֖ים עִמָּדִ֑י"
        },
        {
          "align": "left",
          "width": 0,
          "text": "אֲנִ֧י אָמִ֣ית וַאֲחַיֶּ֗ה"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "מָחַ֙צְתִּי֙ וַאֲנִ֣י אֶרְפָּ֔א"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וְאֵ֥ין מִיָּדִ֖י מַצִּֽיל׃"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "כִּֽי־אֶשָּׂ֥א אֶל־שָׁמַ֖יִם יָדִ֑י"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וְאָמַ֕רְתִּי חַ֥י אָנֹכִ֖י לְעֹלָֽם׃"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "אִם־שַׁנּוֹתִי֙ בְּרַ֣ק חַרְבִּ֔י"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וְתֹאחֵ֥ז בְּמִשְׁפָּ֖ט יָדִ֑י"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "אָשִׁ֤יב נָקָם֙ לְצָרָ֔י"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וְלִמְשַׂנְאַ֖י אֲשַׁלֵּֽם׃"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "אַשְׁכִּ֤יר חִצַּי֙ מִדָּ֔ם"
        },
        {
          "align": "left",
          "width": 0,
          "text": "וְחַרְבִּ֖י תֹּאכַ֣ל בָּשָׂ֑ר"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "מִדַּ֤ם חָלָל֙ וְשִׁבְיָ֔ה"
        },
        {
          "align": "left",
          "width": 0,
          "text": "מֵרֹ֖אשׁ פַּרְע֥וֹת אוֹיֵֽב׃"
        }
      ],
      [
        {
          "align": "right",
          "width": 0,
          "text": "הַרְנִ֤ינוּ גוֹיִם֙ עַמּ֔וֹ"
        },
        {
          "align": "left",
          "width": 0,
          "text": "כִּ֥י דַם־עֲבָדָ֖יו יִקּ֑וֹם"
        }
      ],
      [
        {
          "align": "right",
