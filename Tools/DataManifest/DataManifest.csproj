<Project Sdk="Microsoft.NET.Sdk">
  <!-- Regenerates LeynerLearner\Data\manifest.json's file list (sizes and SHA-256) and builds data-pack zips. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DataManifestTool</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\LeynerLearner\Core\DataManifest.cs" />
  </ItemGroup>
</Project>
